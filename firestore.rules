rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Strictly isolate each user's financial vault under their authenticated UID.
    // No user or third party can read, write, or tamper with another user's financial data.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Scoped vault subcollections (transactions, goals, budgets, accounts)
      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
