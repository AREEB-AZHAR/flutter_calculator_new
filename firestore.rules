rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Strictly isolate each user's financial vault under their authenticated UID.
    // No user or third party can read, write, or tamper with another user's financial data.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Preserve existing owner access for all non-monetization data. Exclude
      // server-owned collections here: Firestore combines overlapping allows.
      match /{subcollection}/{document=**} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId
          && !(subcollection in ['monetization', 'purchases']);
      }
    }
  }
}
